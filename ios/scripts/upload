#!/bin/bash
# Build and upload WindRex from a Mac with XcodeGen and both iOS frameworks.
# The default uses an App Store Connect API key for cloud-managed signing.
# WINDREX_RELEASE_SIGNING=local uses installed distribution signing assets.
# DESTINATION=export writes a signed IPA without uploading. Set BUILD to
# export locally without querying App Store Connect.
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/asc-env
TEAM=${WINDREX_APPLE_TEAM_ID:-}
SIGNING=${WINDREX_RELEASE_SIGNING:-cloud}
DEST=${DESTINATION:-upload}
[[ $TEAM =~ ^[A-Z0-9]{10}$ ]] || { echo "Set WINDREX_APPLE_TEAM_ID to the signing team ID" >&2; exit 1; }
case "$DEST" in
  export|upload) ;;
  *) echo "DESTINATION must be export or upload" >&2; exit 1 ;;
esac
EXPORT_ARGS=(-exportArchive -archivePath build/GoRex.xcarchive -exportOptionsPlist build/export.plist -exportPath build/export)
case "$SIGNING" in
  cloud)
    require_asc_app
    [[ -n $ASC_KEY_ID && -n $ASC_ISSUER_ID && -f $ASC_PRIVATE_KEY_PATH ]] || { echo "Set ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_PATH" >&2; exit 1; }
    export ASC_KEY_ID ASC_ISSUER_ID ASC_PRIVATE_KEY_PATH
    EXPORT_ARGS+=(-allowProvisioningUpdates -authenticationKeyPath "$ASC_PRIVATE_KEY_PATH" -authenticationKeyID "$ASC_KEY_ID" -authenticationKeyIssuerID "$ASC_ISSUER_ID")
    ;;
  local)
    : "${WINDREX_SIGNING_CERTIFICATE:?Set WINDREX_SIGNING_CERTIFICATE to the Apple Distribution certificate hash}"
    : "${WINDREX_APP_PROFILE:?Set WINDREX_APP_PROFILE to the main App Store profile UUID}"
    : "${WINDREX_WIDGET_PROFILE:?Set WINDREX_WIDGET_PROFILE to the widget App Store profile UUID}"
    ;;
  *) echo "WINDREX_RELEASE_SIGNING must be cloud or local" >&2; exit 1 ;;
esac
ASC=(asc)
if [[ -n ${WINDREX_ASC_PROFILE:-} ]]; then
  ASC+=(--profile "$WINDREX_ASC_PROFILE")
fi
XCODE_DEST=$DEST
if [[ $DEST == upload && -n ${WINDREX_ASC_PROFILE:-} ]]; then
  [[ $SIGNING == local ]] || { echo "WINDREX_ASC_PROFILE upload requires local signing" >&2; exit 1; }
  require_asc_app
  : "${WINDREX_TESTFLIGHT_GROUP_ID:?Set WINDREX_TESTFLIGHT_GROUP_ID to the internal group ID}"
  "${ASC[@]}" testflight groups list --app "$APP" --internal --output json |
    python3 -I -c '
import json, sys
groups = json.load(sys.stdin)["data"]
if not any(group["id"] == sys.argv[1] and group["attributes"]["isInternalGroup"] for group in groups):
    sys.exit("The TestFlight group is not an internal group of this app")
' "$WINDREX_TESTFLIGHT_GROUP_ID"
  XCODE_DEST=export
fi
V=$(sed -n 's/^ *MARKETING_VERSION: "\([0-9.]*\)"$/\1/p' project.yml)
[[ $V =~ ^[0-9]+(\.[0-9]+)+$ ]] || { echo "no MARKETING_VERSION in project.yml" >&2; exit 1; }
B=${BUILD:-}
if [[ -z $B ]]; then
  require_asc_app
  B=$(ASC_TIMEOUT=90s "${ASC[@]}" builds next-build-number --app "$APP" --version "$V" --platform IOS --output json |
    python3 -I -c 'import sys,json; print(json.load(sys.stdin)["nextBuildNumber"])')
fi
[[ $B =~ ^[0-9]+$ ]] || { echo "bad build number: $B" >&2; exit 1; }
# The commit About shows; none when run from an archive without .git.
C=$(git rev-parse --short=7 HEAD 2>/dev/null || true)
xcodegen generate -q
mkdir -p build
python3 -I - "$SIGNING" "$XCODE_DEST" "$TEAM" <<'PY'
import os
import plistlib
import sys

signing, destination, team = sys.argv[1:]
options = {
    "method": "app-store-connect",
    "destination": destination,
    "teamID": team,
    "signingStyle": "automatic",
    "manageAppVersionAndBuildNumber": False,
}
if signing == "local":
    options.update(
        signingStyle="manual",
        signingCertificate=os.environ["WINDREX_SIGNING_CERTIFICATE"],
        provisioningProfiles={
            "wiki.wind.windrex": os.environ["WINDREX_APP_PROFILE"],
            "wiki.wind.windrex.widgets": os.environ["WINDREX_WIDGET_PROFILE"],
        },
        testFlightInternalTestingOnly=True,
    )
with open("build/export.plist", "wb") as output:
    plistlib.dump(options, output)
PY
# The archive has no distribution signature until export. Xcode uses a local
# or cloud-managed identity at that point. The export signs each bundle
# with the entitlements its archived signature carries, and an unsigned one
# carries none: the App Group, which the widgets read the app's snapshot
# through, and the iCloud key-value store went missing (docs/IOS-010-widgets.md,
# Build and release). So each bundle is signed ad hoc with its entitlements
# before the export, the innermost first; the export signs it again, for
# the distribution, with them.
sign() { # BUNDLE [ENTITLEMENTS]: signs it ad hoc, with the entitlements
  local id f
  if [[ -z ${2:-} ]]; then codesign -f -s - "$1"; return; fi
  id=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$1/Info.plist")
  [[ -n $id ]] || { echo "no CFBundleIdentifier in $1" >&2; exit 1; }
  f=build/$id.entitlements
  sed -e "s/\$(TeamIdentifierPrefix)/$TEAM./g" -e "s/\$(CFBundleIdentifier)/$id/g" "$2" > "$f"
  codesign -f -s - --entitlements "$f" "$1"
}
sign_entitlements() { # APP
  local f
  for f in "$1"/Frameworks/*.framework; do
    if [[ -e $f ]]; then sign "$f"; fi
  done
  sign "$1/PlugIns/GoRexWidgets.appex" GoRexWidgets/GoRexWidgets.entitlements
  sign "$1" GoRex/GoRex.entitlements
}
# The packages, GhosttyKit's binaries from GitHub among them, before the
# archive: a download GitHub fails (a 504 at times) is tried again.
for n in 1 2 3; do
  xcodebuild -resolvePackageDependencies -scheme GoRex > build/resolve.log 2>&1 && break
  grep -E "error|failed" build/resolve.log | tail -5 || true
  [[ $n -lt 3 ]] || exit 1
  sleep $((n * 30))
done
# Another upload can take the build number between the query and ours: then
# take the next one, twice at most.
for try in 0 1 2; do
  echo "BUILD $V ($B)"
  rm -rf build/GoRex.xcarchive build/export
  xcodebuild -scheme GoRex -destination generic/platform=iOS -archivePath build/GoRex.xcarchive \
    CURRENT_PROJECT_VERSION="$B" GOREX_COMMIT="$C" DEVELOPMENT_TEAM="$TEAM" WINDREX_PUSH_RELAY_URL="${WINDREX_PUSH_RELAY_URL:-}" CODE_SIGNING_ALLOWED=NO archive > build/archive.log 2>&1 || { grep -E "error" build/archive.log | tail -15; exit 1; }
  echo ARCHIVED
  sign_entitlements build/GoRex.xcarchive/Products/Applications/GoRex.app
  scripts/verify-entitlements build/GoRex.xcarchive/Products/Applications/GoRex.app "$TEAM"
  xcodebuild "${EXPORT_ARGS[@]}" > build/export.log 2>&1 && break
  grep -iE "error" build/export.log | tail -15 || true
  [[ $try -lt 2 ]] && grep -qiE "redundant binary upload|already (been )?(used|uploaded)|must be higher than the previously" build/export.log || exit 1
  B=$((B + 1))
done
tail -3 build/export.log
if [[ $XCODE_DEST == export ]]; then
  scripts/verify-entitlements build/export/GoRex.ipa "$TEAM"
fi
[[ $DEST == upload ]] || { echo "EXPORTED $V ($B) to build/export"; exit 0; }
if [[ $XCODE_DEST == export ]]; then
  "${ASC[@]}" publish testflight --app "$APP" --ipa build/export/GoRex.ipa \
    --group "$WINDREX_TESTFLIGHT_GROUP_ID" --wait
fi
echo "UPLOADED $V ($B)"
