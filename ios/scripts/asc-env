# shellcheck shell=bash disable=SC2034
# App Store Connect credentials shared by the upload and tester scripts.
PATH=$PATH:/opt/homebrew/bin
APP=${WINDREX_ASC_APP_ID:-}
ASC_KEY_ID=${ASC_KEY_ID:-}
ASC_ISSUER_ID=${ASC_ISSUER_ID:-}
ASC_PRIVATE_KEY_PATH=${ASC_KEY_PATH:-$HOME/.appstoreconnect/private_keys/AuthKey_$ASC_KEY_ID.p8}

require_asc_app() {
  [[ $APP =~ ^[0-9]+$ ]] || { echo "Set WINDREX_ASC_APP_ID to the WindRex app's numeric Apple ID" >&2; return 1; }
}
